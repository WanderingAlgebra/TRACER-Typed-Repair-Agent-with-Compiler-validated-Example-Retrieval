{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/leancapsule-v0.1.schema.json",
  "title": "LeanCapsule manifest",
  "type": "object",
  "required": ["schema_version", "capsule_id", "target", "environment", "expected", "provenance"],
  "properties": {
    "schema_version": {"const": "leancapsule.v0.1"},
    "capsule_id": {"type": "string", "minLength": 1},
    "target": {
      "type": "object",
      "required": ["source_file", "selection_mode"],
      "properties": {
        "source_file": {"type": "string"},
        "theorem": {"type": ["string", "null"]},
        "lines": {"type": ["string", "null"]},
        "selection_mode": {"enum": ["theorem", "lines"]}
      }
    },
    "environment": {"type": "object"},
    "expected": {
      "type": "object",
      "required": ["compile_ok", "category", "diagnostic_key"],
      "properties": {
        "compile_ok": {"type": "boolean"},
        "category": {"type": "string"},
        "diagnostic_key": {"type": "string"}
      }
    },
    "minimization": {"type": "object"},
    "provenance": {"type": "object"}
  }
}
